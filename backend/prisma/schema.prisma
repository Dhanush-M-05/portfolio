datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Profile {
  id              String   @id @default(uuid())
  name            String
  role            String?
  title           String?
  college         String?
  department      String?
  degree          String?
  course          String?
  domain          String?
  location        String?
  email           String?
  phone           String?
  tagline         String?
  bio             String?  @db.Text
  shortBio        String?  @db.Text
  heroDescription String?  @db.Text
  aboutHeading    String?
  aboutSubheading String?
  avatarUrl       String?  @db.Text
  avatarPublicId  String?
  stats           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

model Hero {
  id               String   @id @default(uuid())
  greeting         String   @default("HELLO, I'M")
  roleTitle        String?
  tagline          String?
  description      String?  @db.Text
  primaryBtnText   String   @default("View My Work")
  primaryBtnLink   String   @default("#projects")
  secondaryBtnText String   @default("Let's Talk")
  secondaryBtnLink String   @default("#contact")
  talkLinkText     String   @default("Let's Talk")
  resumeBtnText    String   @default("Download Resume")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hero_sections")
}

model About {
  id                  String   @id @default(uuid())
  heading             String?
  subheading          String?
  shortIntro          String?  @db.Text
  description         String?  @db.Text
  professionalSummary String?  @db.Text
  yearsExperience     String?
  projectsCompleted   String?
  degree              String?
  cgpa                String?
  skillsHighlight     String?  @db.Text
  imageUrl            String?  @db.Text
  imagePublicId       String?
  ctaText             String?
  ctaLink             String?
  resumeUrl           String?  @db.Text
  email               String?
  phone               String?
  location            String?
  coreFocus           Json?
  paragraphs          Json?
  highlights          Json?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("about_sections")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  category    String
  proficiency Int      @default(85)
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("skills")
}

model Project {
  id                String         @id @default(uuid())
  title             String
  slug              String         @unique
  shortDescription  String?        @db.Text
  description       String?        @db.Text
  tagline           String?
  category          String?
  technologies      Json?
  features          Json?
  githubUrl         String?
  liveUrl           String?
  liveDemoBtnText   String?
  githubBtnText     String?
  detailsBtnText    String?
  thumbnailUrl      String?        @db.Text
  thumbnailPublicId String?
  featured          Boolean        @default(false)
  order             Int            @default(0)
  isActive          Boolean        @default(true)
  images            ProjectImage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  imageUrl  String   @db.Text
  publicId  String
  caption   String?
  order     Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_images")
}

model Experience {
  id           String   @id @default(uuid())
  company      String
  position     String
  location     String?
  startDate    String?
  endDate      String?
  isCurrent    Boolean  @default(false)
  description  String?  @db.Text
  technologies Json?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("experiences")
}

model Education {
  id          String   @id @default(uuid())
  institution String
  degree      String
  department  String?
  startYear   String?
  endYear     String?
  grade       String?
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("educations")
}

model Certification {
  id                  String   @id @default(uuid())
  title               String
  issuer              String
  issueDate           String?
  credentialId        String?
  credentialUrl       String?
  certificateUrl      String?  @db.Text
  certificatePublicId String?
  certificateFilename String?
  certificateMimeType String?
  certificateSize     Int?
  skillsCovered       Json?
  description         String?  @db.Text
  order               Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("certifications")
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  date        String?
  category    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("achievements")
}

model Resume {
  id        String   @id @default(uuid())
  title     String   @default("Developer Resume")
  fileName  String   @default("Dhanush-M-Resume.pdf")
  fileUrl   String   @db.Text
  publicId  String
  mimeType  String   @default("application/pdf")
  fileSize  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resumes")
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  label     String
  url       String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_links")
}

model NavigationItem {
  id           String   @id @default(uuid())
  label        String
  url          String
  target       String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  isVisible    Boolean  @default(true)
  openInNewTab Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("navigation_items")
}

model Footer {
  id                String   @id @default(uuid())
  brandName         String?
  brandRole         String?
  tagline           String?
  quickLinksHeading String?
  deepLinksHeading  String?
  contactHeading    String?
  contactDesc       String?  @db.Text
  copyrightText     String?
  email             String?
  phone             String?
  location          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("footers")
}

model WebsiteSettings {
  id                 String   @id @default(uuid())
  siteTitle          String?
  siteDescription    String?  @db.Text
  favicon            String?
  metaKeywords       String?
  googleAnalyticsId  String?
  maintenanceMode    Boolean  @default(false)
  brandName          String?
  brandRole          String?
  logoLetters        String?
  resumeBtnText      String?
  talkBtnText        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("website_settings")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model HomepageSection {
  id         String   @id @default(uuid())
  sectionKey String   @unique
  name       String?
  label      String?
  title      String?
  subtitle   String?  @db.Text
  order      Int      @default(0)
  isVisible  Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("homepage_sections")
}
