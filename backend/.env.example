PORT=5000

# MySQL Connection String (e.g. mysql://USER:PASSWORD@localhost:3306/portfolio_db)
DATABASE_URL="mysql://root:password@localhost:3306/portfolio_db"

JWT_SECRET="replace_with_a_random_jwt_secret"
JWT_EXPIRES_IN="7d"

# Admin Login Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace_with_a_secure_password"

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Portfolio <onboarding@resend.dev>"
EMAIL_TO="admin@example.com"

FRONTEND_URL="http://localhost:5173"

NODE_ENV="development"
